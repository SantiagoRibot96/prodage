# --- Redis (Upstash, vía Vercel Marketplace) ---
# Se generan solas al conectar la integración "Redis" (Marketplace -> Storage)
# a tu proyecto en el dashboard de Vercel. En local, copiá los valores que te
# muestra Vercel (Storage -> tu base -> .env.local) a un archivo .env.local
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- NextAuth ---
# Generá uno con: openssl rand -base64 32
NEXTAUTH_SECRET=
# En local: http://localhost:3000  |  En Vercel se puede omitir (se autodetecta)
NEXTAUTH_URL=http://localhost:3000

# --- Códigos de invitación ---
# Código que compartís con tus amigos para que se registren
INVITE_CODE=rda2025
# Código extra (solo vos lo sabés) que además da permisos de administrador
ADMIN_INVITE_CODE=rda-admin-2025
